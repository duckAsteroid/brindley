{
  "name": "brindley",
  "version": "0.0.0-development",
  "description": "Design fully before anyone digs \u2014 in-repo Markdown initiatives for AI-agent workflows, plus an MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brindley": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node scripts/version.mjs --write",
    "build": "tsc -p tsconfig.json",
    "pretest": "node scripts/version.mjs --write",
    "test": "vitest run",
    "typecheck": "node scripts/version.mjs --write && tsc -p tsconfig.json --noEmit",
    "version:explain": "node scripts/version.mjs --explain",
    "version:sync": "node scripts/version.mjs --sync",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckAsteroid/brindley.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "planning",
    "markdown",
    "initiatives"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ignore": "^7.0.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://duckasteroid.github.io/brindley/",
  "bugs": {
    "url": "https://github.com/duckAsteroid/brindley/issues"
  },
  "author": "Chris Senior"
}
